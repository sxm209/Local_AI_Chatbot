{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local AI Chatbot",
  "version": "0.1.0",
  "identifier": "com.localchatbot.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev --prefix frontend",
    "beforeBuildCommand": "npm.cmd run build --prefix frontend",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local AI Chatbot",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/local-chatbot-backend"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
